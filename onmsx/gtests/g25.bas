VBANK 1
VPOKE 100, 99
VFILL 200, 5, 33
VWRITE 300, "AB"
a$ = VREAD$(300, 2)
VPOKE 401, VPEEK(100)
VBANK 0
VPOKE 400, VPEEK(100)
VPOKE 402, ASC(a$)
VPOKE 403, LEN(a$)
VPOKE 404, BASE(28) / 256
VDP(7) = 9
VPOKE 406, VDP(7)
VPOKE 407, STICK(0)
VPOKE 408, 0 - STRIG(0)
COLOR = (3, 7, 0, 5)
