l risultato"}, {"f": "onmsx/qbc.asm", "l": 5658, "t": "+16 definita, +17 +18 indirizzo, +19 +20 catena, +21 maschera, +22 +23"}, {"f": "onmsx/qbc.asm", "l": 5695, "t": "indice del parametro"}, {"f": "onmsx/qbc.asm", "l": 5712, "t": "tipo del parametro"}, {"f": "onmsx/qbc.asm", "l": 5715, "t": "+13 = 1 se array"}, {"f": "onmsx/qbc.asm", "l": 5875, "t": "tipo degli elementi diverso da quello del parametro"}, {"f": "onmsx/qbc.asm", "l": 5929, "t": "e' una CONST"}, {"f": "onmsx/qbc.asm", "l": 5994, "t": "routine in un altro segmento: ld a,indice ; call RT_FARCALL"}, {"f": "onmsx/qbc.asm", "l": 6091, "t": "parametri gia' registrati dal prescan"}, {"f": "onmsx/qbc.asm", "l": 6165, "t": "scostamento corrente"}, {"f": "onmsx/qbc.asm", "l": 6188, "t": "tipo (0 int / 1 str)"}, {"f": "onmsx/qbc.asm", "l": 6227, "t": "crea la variabile locale risultato"}, {"f": "onmsx/qbc.asm", "l": 6266, "t": "risultato: richiama la variabile locale"}, {"f": "onmsx/qbc.asm", "l": 6301, "t": "dimensione del frame: 64 + 256 * stringhe locali (operando = -frame)"}, {"f": "onmsx/qbc.asm", "l": 6433, "t": "DO UNTIL cond: esce se vera"}, {"f": "onmsx/qbc.asm", "l": 6441, "t": "DO WHILE cond: esce se falsa"}, {"f": "onmsx/qbc.asm", "l": 6525, "t": "+9 = tipo del selettore"}, {"f": "onmsx/qbc.asm", "l": 6617, "t": "c = catena del corpo"}, {"f": "onmsx/qbc.asm", "l": 6664, "t": "nessuna corrispondenza: al prossimo CASE"}, {"f": "onmsx/qbc.asm", "l": 6706, "t": "posto del record"}, {"f": "onmsx/qbc.asm", "l": 6858, "t": "COLOR SPRITE$(n) = colors per line"}, {"f": "onmsx/qbc.asm", "l": 6891, "t": "VWRITE indirizzo, stringa"}, {"f": "onmsx/qbc.asm", "l": 6936, "t": "VREAD$(indirizzo, quanti)"}, {"f": "onmsx/qbc.asm", "l": 7013, "t": "HL = indirizzo: emette ld (nn),hl"}, {"f": "onmsx/qbc.asm", "l": 7151, "t": "indirizzo del blocco"}, {"f": "onmsx/qbc.asm", "l": 7360, "t": "PRINT [#n,] elementi"}, {"f": "onmsx/qbc.asm", "l": 7381, "t": "WRITE [#n,] elementi"}, {"f": "onmsx/qbc.asm", "l": 7930, "t": "azione predefinita XOR"}, {"f": "onmsx/rtabi.inc", "l": 12, "t": "Punti d'ingresso del runtime (tabella di JP a indirizzi fissi, immagine a 0100h)"}, {"f": "onmsx/rtabi.inc", "l": 130, "t": "jp rt_dbg: gancio del debugger (OPTION DEBUG)"}, {"f": "onmsx/rtabi.inc", "l": 137, "t": "RAM del runtime (C000h-C086h: caricatore)"}, {"f": "onmsx/rtabi.inc", "l": 154, "t": "bits per pixel, pixels per byte, color mask"}, {"f": "onmsx/rtabi.inc", "l": 201, "t": "VIEW: finestra di ritaglio (limiti inclusi) e sue dimensioni"}, {"f": "onmsx/rtabi.inc", "l": 228, "t": "... scostamento dell'indirizzo VRAM (16 bit bassi)"}, {"f": "onmsx/rtabi.inc", "l": 229, "t": "... A16 dell'indirizzo VRAM"}, {"f": "onmsx/rtabi.inc", "l": 230, "t": "COPY: pagina sorgente, destinazione (x,y), pagina destinazione (-1 = attiva)"}, {"f": "onmsx/rtabi.inc", "l": 236, "t": "PLAY: frequenza di quadro * 240"}, {"f": "onmsx/rtabi.inc", "l": 241, "t": "ROM: software stack of cross-segment calls"}, {"f": "onmsx/rtabi.inc", "l": 248, "t": "scratch del rilevamento"}, {"f": "onmsx/rtabi.inc", "l": 256, "t": "0 = MSX1 (TMS9918: niente R#14, niente 80 colonne), altrimenti MSX2 o superiore"}, {"f": "onmsx/rtbin.asm", "l": 40, "t": "WRITE: stringa tra virgolette"}, {"f": "onmsx/rtcirc.asm", "l": 36, "t": "0..179 -> sin (91..179 si specchiano su 89..1)"}, {"f": "onmsx/rtcirc.asm", "l": 121, "t": "segmento dal punto precedente"}, {"f": "onmsx/rtcom.asm", "l": 3, "t": "Tabella di JP a indirizzi fissi (vedi rtabi.inc), BIOS via CALSLT."}, {"f": "onmsx/rtcom.asm", "l": 503, "t": "DOS 2: CHDIR in SPBHOME (directory degli strumenti); DOS 1 e variabile assente: nulla"}, {"f": "onmsx/rtcom.asm", "l": 707, "t": "signed compare: DE = left, HL = right -> Z equal, C if DE<HL"}, {"f": "onmsx/rtcom.asm", "l": 820, "t": "HL = sorgente, DE = buffer destinazione"}, {"f": "onmsx/rtcom.asm", "l": 1081, "t": "confronto stringhe: DE = sinistra, HL = destra -> Z uguale, C se DE<HL"}, {"f": "onmsx/rtcom.asm", "l": 1243, "t": "fila di tastiera selezionata"}, {"f": "onmsx/rtdbg.asm", "l": 2, "t": "Debugger a strumentazione (OPTION DEBUG)"}, {"f": "onmsx/rtdbg.asm", "l": 13, "t": "1 = passo-passo, 0 = esegui fino a un breakpoint"}, {"f": "onmsx/rtdbg.asm", "l": 105, "t": "si parte in passo-passo"}, {"f": "onmsx/rtdbg.asm", "l": 118, "t": "HL = indirizzo (< 16 KB), A = 0 lettura / 40h scrittura"}, {"f": "onmsx/rtdbg.asm", "l": 232, "t": "font del BIOS: ASCII 32-95"}, {"f": "onmsx/rtfile.asm", "l": 3, "t": "INPUT#, LINE INPUT#, EOF, KILL. Fino a 3 file (#1-#3), i descrittori stanno in cima allo heap."}, {"f": "onmsx/rtfile.asm", "l": 16, "t": "scostamento del prossimo campo"}, {"f": "onmsx/rtfile.asm", "l": 45, "t": "C = funzione, DE = parametro (conserva IX)"}, {"f": "onmsx/rtfile.asm", "l": 52, "t": "riserva i 3 descrittori (una volta sola)"}, {"f": "onmsx/rtfile.asm", "l": 110, "t": "DMA = buffer del descrittore IX"}, {"f": "onmsx/rtfile.asm", "l": 277, "t": "aggiunta: apre, altrimenti crea"}, {"f": "onmsx/rtfile.asm", "l": 366, "t": "accesso casuale: niente da scaricare"}, {"f": "onmsx/rtfile.asm", "l": 596, "t": "INPUT # (un campo) -> HL = stringa"}, {"f": "onmsx/rtfile.asm", "l": 629, "t": "campo tra virgolette"}, {"f": "onmsx/rtfile.asm", "l": 679, "t": "WRITE: stringa tra virgolette"}, {"f": "onmsx/rtfile.asm", "l": 991, "t": "B = indice del campo -> HL = voce"}, {"f": "onmsx/rtfile.asm", "l": 1047, "t": "scostamento"}, {"f": "onmsx/rtfile.asm", "l": 1087, "t": "scostamento"}, {"f": "onmsx/rtfile.asm", "l": 1098, "t": "DE = destinazione"}, {"f": "onmsx/rtgfx.asm", "l": 111, "t": "SCREEN 10-12: one byte per pixel like SCREEN 8"}, {"f": "onmsx/rtgfx.asm", "l": 307, "t": "colore e argomento del comando in GCMD"}, {"f": "onmsx/rtgfx.asm", "l": 419, "t": "DE = b, HL = a: C se b < a"}, {"f": "onmsx/rtgfx.asm", "l": 445, "t": "C se x1 < VX1"}, {"f": "onmsx/rtgfx.asm", "l": 457, "t": "C se VX2 < x2"}, {"f": "onmsx/rtgfx.asm", "l": 521, "t": "riquadro: quattro lati sottili (rect_draw modifica S1..S4: si ricaricano)"}, {"f": "onmsx/rtgfx.asm", "l": 564, "t": "comando LINE hardware"}, {"f": "onmsx/rtgfx.asm", "l": 656, "t": "C se e2 < dy"}, {"f": "onmsx/rtgfx.asm", "l": 668, "t": "C se dx < e2"}, {"f": "onmsx/rtgfx.asm", "l": 680, "t": "BC = scostamento x, DE = scostamento y dal centro (GX1,GY1)"}, {"f": "onmsx/rtgfx.asm", "l": 758, "t": "altrimenti x--, d += 2(y - x) + 1"}, {"f": "onmsx/rtgfx.asm", "l": 772, "t": "---------------------------------------------------------------- SCREEN 2 (MSX1 graphics: 8x1 patterns with color per group)"}, {"f": "onmsx/rtgfx.asm", "l": 773, "t": "HL = x, DE = y -> (P2OFF) = scostamento nelle tabelle, (P2MSK) = maschera del bit"}, {"f": "onmsx/rtgfx.asm", "l": 880, "t": "HL = x, DE = y -> A = colore del pixel"}, {"f": "onmsx/rtgtext.asm", "l": 44, "t": "bits per pixel, pixels per byte, color mask, based on SCRMODE"}, {"f": "onmsx/rtgtext.asm", "l": 59, "t": "SCREEN 2: lines read as one byte per pixel (color)"}, {"f": "onmsx/rtgtext.asm", "l": 92, "t": "-> A = bytes per pixel line: 128, or 0 = 256"}, {"f": "onmsx/rtgtext.asm", "l": 162, "t": "2 bits per pixel"}, {"f": "onmsx/rtgtext.asm", "l": 202, "t": "address = TCY*8*stride + TCX*bytes-per-cell"}, {"f": "onmsx/rtgtext.asm", "l": 219, "t": "bytes per cell 4 (log2 = 2)"}, {"f": "onmsx/rtgtext.asm", "l": 259, "t": "HL = indirizzo VRAM (16 bit + VA16 = A16), A = 0 lettura / 40h scrittura"}, {"f": "onmsx/rtgtext.asm", "l": 301, "t": "E = pixels per VRAM byte"}, {"f": "onmsx/rtgtext.asm", "l": 307, "t": "mask <<= bits per pixel"}, {"f": "onmsx/rtgtext.asm", "l": 538, "t": "4 bits per pixel"}, {"f": "onmsx/rtgtext.asm", "l": 746, "t": "scostamento = TCY*256 + TCX*8"}, {"f": "onmsx/rtgtext.asm", "l": 840, "t": "SCREEN 2, HL = y: ROWBUF[x] = colore del pixel (x, y)"}, {"f": "onmsx/rtgx.asm", "l": 2, "t": "GET/PUT di aree, DRAW e COLLISION (SCREEN 5-8)"}, {"f": "onmsx/rtgx.asm", "l": 3, "t": "GET (x1,y1)-(x2,y2), array   -> array: [width][height] then one byte per pixel (2 pixels per element)"}, {"f": "onmsx/rtgx.asm", "l": 4, "t": "PUT (x,y), array[, azione]   -> azione 0 PSET, 1 PRESET, 2 AND, 3 OR, 4 XOR (predefinita)"}, {"f": "onmsx/rtgx.asm", "l": 49, "t": "4 bits per pixel"}, {"f": "onmsx/rtgx.asm", "l": 89, "t": "D = posizione del pixel (bit)"}, {"f": "onmsx/rtgx.asm", "l": 150, "t": "larghezza S5, altezza S6 -> HL = elementi dell'array (2 + (w*h+1)/2)"}, {"f": "onmsx/rtgx.asm", "l": 280, "t": "A = pixel di destinazione"}, {"f": "onmsx/rtgx.asm", "l": 290, "t": "1 PRESET: complemento"}, {"f": "onmsx/rtgx.asm", "l": 332, "t": "-> A = prossimo carattere significativo (maiuscolo), Z se finito"}, {"f": "onmsx/rtgx.asm", "l": 362, "t": "consuma un carattere"}, {"f": "onmsx/rtgx.asm", "l": 421, "t": "(S1,S2) = nuova posizione: disegna o sposta (prefissi B e N)"}, {"f": "onmsx/rtgx.asm", "l": 461, "t": "HL = stringa di comandi (U D L R E F G H M B N C S)"}, {"f": "onmsx/rtgx.asm", "l": 531, "t": "U D L R E F G H: direzione -> (dx, dy)"}, {"f": "onmsx/rtgx.asm", "l": 588, "t": "TRPTBL (FC4Ch) + 11 * 3: voce degli sprite"}, {"f": "onmsx/rtgx.asm", "l": 590, "t": "attiva l'evento di collisione degli sprite"}, {"f": "onmsx/rtgx.asm", "l": 649, "t": "A = pixel di destinazione"}, {"f": "onmsx/rtmap.asm", "l": 2, "t": "Mapper RAM (MSX2): segmenti da 16 KB visti attraverso la pagina 2 (8000h-BFFF, porta FEh)."}, {"f": "onmsx/rtmap.asm", "l": 3, "t": "MAPPERSEGS, MGET, MPUT, MREAD, MWRITE. Nei .COM la pagina 2 e' la RAM del mapper (si accede direttamente e si"}, {"f": "onmsx/rtmap.asm", "l": 13, "t": "HL = indirizzo (pagina 2) -> A"}, {"f": "onmsx/rtmap.asm", "l": 44, "t": "A = segmento: si ricorda quello attuale"}, {"f": "onmsx/rtmap.asm", "l": 108, "t": "nessun alias fino a 128: 256 segmenti"}, {"f": "onmsx/rtmap.asm", "l": 115, "t": "meno di 4 segmenti: niente mapper"}, {"f": "onmsx/rtmap.asm", "l": 183, "t": "GY1 = offset, GY2 = quanti, GX2 = indirizzo: controlli comuni -> HL = 8000h + offset, DE = indirizzo, BC = quanti"}, {"f": "onmsx/rtmap.asm", "l": 309, "t": "