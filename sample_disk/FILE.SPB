' Text file: write, read back, append
OPEN "PROVA.TXT" FOR OUTPUT AS #1
PRINT #1, "first line"
WRITE #1, "name", 42, -7
CLOSE #1
OPEN "PROVA.TXT" FOR APPEND AS #1
PRINT #1, "last"
CLOSE #1
OPEN "PROVA.TXT" FOR INPUT AS #1
DO WHILE NOT EOF(1)
  LINE INPUT #1, r$
  PRINT r$
LOOP
CLOSE #1
KILL "PROVA.TXT"
