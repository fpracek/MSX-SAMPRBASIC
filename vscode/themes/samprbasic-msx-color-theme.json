{
  "name": "SamPr Basic MSX",
  "type": "dark",
  "colors": {
    "editor.background": "#2424FF",
    "editor.foreground": "#FFFFFF",
    "editorLineNumber.foreground": "#B8B8FF",
    "editorLineNumber.activeForeground": "#FFFFFF",
    "editorCursor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#FFFFFF55",
    "editor.lineHighlightBackground": "#3A3AFF",
    "editorRuler.foreground": "#6666FF",
    "editorGutter.background": "#2424FF",
    "editorWidget.background": "#1818C8",
    "sideBar.background": "#1B1BD8",
    "sideBar.foreground": "#FFFFFF",
    "sideBarTitle.foreground": "#FFFFFF",
    "activityBar.background": "#10109A",
    "activityBar.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#FFFFFF",
    "titleBar.activeForeground": "#2424FF",
    "tab.activeBackground": "#2424FF",
    "tab.inactiveBackground": "#1B1BD8",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveForeground": "#C8C8FF",
    "editorGroupHeader.tabsBackground": "#1B1BD8",
    "statusBar.background": "#FFFFFF",
    "statusBar.foreground": "#2424FF",
    "panel.background": "#1B1BD8",
    "terminal.background": "#1B1BD8",
    "scrollbarSlider.background": "#FFFFFF55",
    "list.activeSelectionBackground": "#FFFFFF",
    "list.activeSelectionForeground": "#2424FF",
    "list.hoverBackground": "#3A3AFF",
    "input.background": "#1818C8",
    "dropdown.background": "#1818C8",
    "menu.background": "#FFFFFF",
    "menu.foreground": "#2424FF",
    "menubar.selectionBackground": "#2424FF"
  },
  "tokenColors": [
    { "scope": ["keyword.control.samprbasic", "keyword.operator.word.samprbasic", "keyword.other.mnemonic.asm", "keyword.control.directive.asm"], "settings": { "foreground": "#FFE066" } },
    { "scope": ["support.function.samprbasic"], "settings": { "foreground": "#FFE066" } },
    { "scope": ["comment", "comment.line.samprbasic", "comment.line.semicolon.asm"], "settings": { "foreground": "#B8B8FF", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted.double.samprbasic", "string.quoted.double.asm"], "settings": { "foreground": "#FFFFFF" } },
    { "scope": ["constant.numeric", "constant.numeric.samprbasic", "constant.numeric.asm", "constant.numeric.linenumber.samprbasic"], "settings": { "foreground": "#FFFFFF" } },
    { "scope": ["entity.name.function.samprbasic", "entity.name.label.samprbasic", "entity.name.label.asm"], "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" } },
    { "scope": ["support.constant.samprbasic", "support.type.register.asm", "keyword.operator.condition.asm"], "settings": { "foreground": "#9CF0FF" } }
  ]
}
