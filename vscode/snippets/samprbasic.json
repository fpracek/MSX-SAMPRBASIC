{
 "SUB": {
  "prefix": "sub",
  "body": [
   "SUB ${1:name}(${2})",
   "  $0",
   "END SUB"
  ],
  "description": "SUB procedure"
 },
 "FUNCTION": {
  "prefix": "function",
  "body": [
   "FUNCTION ${1:name}(${2})",
   "  ${1:name} = ${3:0}",
   "END FUNCTION"
  ],
  "description": "FUNCTION"
 },
 "IF": {
  "prefix": "if",
  "body": [
   "IF ${1:condition} THEN",
   "  $0",
   "END IF"
  ],
  "description": "IF block"
 },
 "IFELSE": {
  "prefix": "ifelse",
  "body": [
   "IF ${1:condition} THEN",
   "  $2",
   "ELSE",
   "  $0",
   "END IF"
  ],
  "description": "IF/ELSE block"
 },
 "FOR": {
  "prefix": "for",
  "body": [
   "FOR ${1:i} = ${2:1} TO ${3:10}",
   "  $0",
   "NEXT ${1:i}"
  ],
  "description": "FOR loop"
 },
 "WHILE": {
  "prefix": "while",
  "body": [
   "WHILE ${1:condition}",
   "  $0",
   "WEND"
  ],
  "description": "WHILE loop"
 },
 "DO": {
  "prefix": "do",
  "body": [
   "DO",
   "  $0",
   "LOOP UNTIL ${1:condition}"
  ],
  "description": "DO loop"
 },
 "SELECT": {
  "prefix": "select",
  "body": [
   "SELECT CASE ${1:value}",
   "  CASE ${2:1}",
   "    $0",
   "  CASE ELSE",
   "    ",
   "END SELECT"
  ],
  "description": "SELECT CASE"
 },
 "ASM": {
  "prefix": "asm",
  "body": [
   "__ASM",
   "  $0",
   "__ENDASM"
  ],
  "description": "Inline Z80 assembler block"
 },
 "TARGET": {
  "prefix": "target",
  "body": [
   "OPTION TARGET ${1|DOS,BIN,ROM_16,ROM_32,ROM_ASCII8,ROM_ASCII16,ROM_KONAMI,ROM_KONAMISCC|}"
  ],
  "description": "Output type"
 }
}