' Inline Z80 assembler: __ASM ... __ENDASM
CONTA = 0
NOME$ = "ab"
__ASM
; add 2 to CONTA, then 5 more times
        LD HL,(CONTA)
        INC HL
        INC HL
        LD (CONTA),HL
        LD B,5
giro:   LD HL,(CONTA)
        INC HL
        LD (CONTA),HL
        DJNZ giro
        LD HL,NOME$     ; a string variable is [length][characters]
        LD (HL),1
        INC HL
        LD (HL),'Z'
__ENDASM
PRINT CONTA
PRINT NOME$
END
